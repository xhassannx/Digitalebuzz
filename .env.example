# Database Adapter Selection ('postgres' (default) or 'mongodb')
DB_ADAPTER=postgres

# MongoDB Configuration (when DB_ADAPTER=mongodb)
# Local Replica Set: mongodb://127.0.0.1:27017/digitalebuzz?replicaSet=rs0
# MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/digitalebuzz?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/digitalebuzz

# Database Configuration (any Postgres: Neon, Supabase, AWS RDS, self-hosted)
# Examples:
#   Neon:       postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase:   postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require
#   AWS RDS:    postgresql://user:pass@xxx.rds.amazonaws.com:5432/dbname?sslmode=no-verify
#               (sslmode=require also works — app forces rejectUnauthorized:false for RDS)
#   Self-host:  postgresql://user:pass@127.0.0.1:5432/dbname
# URL-encode special chars in the password (e.g. @ → %40). Do not wrap the value in quotes in .env if your loader keeps them.
DATABASE_URL=postgresql://localhost:5432/whatsapp_saas
PGHOST=localhost
PGPORT=5432
PGUSER=your_username
PGPASSWORD=your_password
PGDATABASE=whatsapp_saas
# Optional SSL / network overrides (usually not needed — auto-detected from URL / host):
# DATABASE_SSL=require          # force TLS (CA verify off)
# DATABASE_SSL=verify           # force TLS + verify CA
# DATABASE_SSL=disable          # force no TLS
# PGSSL_REJECT_UNAUTHORIZED=false
# PG_DNS_RESULT_ORDER=ipv4first # default; set verbatim only if you need IPv6-first
# PG_CONNECTION_TIMEOUT_MS=30000

# Session Secret (Generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OIDC Authentication (Optional - for Replit Auth)
# If testing locally without Replit Auth, leave these commented out
# ISSUER_URL=https://replit.com
# CLIENT_ID=your-client-id
# CLIENT_SECRET=your-client-secret

# Force Local Password Authentication (Optional)
# Set to 'true' to use password auth even if OIDC credentials are present
# Useful for testing signup/login pages in OIDC-enabled environments
# FORCE_LOCAL_AUTH=true

# Payment Gateway - Razorpay (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Payment Gateway - Stripe (Optional)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# WhatsApp Business API (Optional - for Official Mode)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Meta / WhatsApp OAuth & post-connect permissions (tech partner / whitelabel)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# BASE_URL=https://your-panel-domain.com
# EMBEDDED_SIGNUP_CONFIG_ID=          # Meta → WhatsApp → Embedded Signup Builder
# META_SYSTEM_USER_ID=                # From Business settings → System users (BM id)
# META_SYSTEM_USER_TOKEN=             # Generate token on that system user for your app
# META_SYSTEM_USER_APP_SCOPED_ID=     # Optional; auto-resolved from token via debug_token if omitted
# Multi-tenant: Meta webhook hits licensor once; forward to whitelabel panels
# CUSTOMER_API_BASE_URL=https://your-licensor-panel.com
# (override_callback_uri becomes {CUSTOMER_API_BASE_URL}/api/webhooks/whatsapp-business)
# CENTRAL_WEBHOOK_VERIFY_TOKEN=  # On whitelabel: must match WEBHOOK_VERIFY_TOKEN on licensor (admin host)
# WEBHOOK_VERIFY_TOKEN=          # Same value on licensor + Meta App → WhatsApp webhook + all whitelabels
# WEBHOOK_URL= optional explicit override (wins over CUSTOMER_API_BASE_URL)
# BASE_URL=https://this-whitelabel-instance.com  (panel URL, not necessarily Meta webhook)
# META_PARTNER_BUSINESS_ID=           # Your Meta Business portfolio ID (optional in embedded signup extras)
# META_PARTNER_BUSINESS_NAME=DigitaleBuzz
# Credit-line (e.g. Interakt): configure in Admin → Wallet billing → Credit-line providers
# (access token, Partner Solution ID). Per-org mode: Admin → Users → WhatsApp billing mode.
# Share this webhook with the supplier as default callback for number connect:
#   {BASE_URL}/api/webhooks/credit-line
# Optional override:
# CREDIT_LINE_WEBHOOK_URL=https://your-panel.com/api/webhooks/credit-line
# CREDIT_LINE_WEBHOOK_VERIFY_TOKEN=   # defaults to WEBHOOK_VERIFY_TOKEN
# On central/admin host, WEBHOOK_FORWARD_URLS also forwards credit-line callbacks to each whitelabel.
# Rare: restrict which WABA lines appear after OAuth (comma-separated WABA IDs). Normally users pick lines in Integrations UI.
# WHATSAPP_OAUTH_ONLY_WABA_IDS=

# Figma (optional — export panel designs: node scripts/fetch-figma-panel-design.mjs ratehonk-v1)
# FIGMA_ACCESS_TOKEN=figd_your_personal_access_token

# Application Settings
NODE_ENV=development
PORT=5000
# Business timezone for Meet links, AI booking slots, campaigns, delays (IANA name)
DEFAULT_TIMEZONE=Asia/Kolkata
# Optional: also set TZ so the Node process local clock matches (Linux/macOS)
# TZ=Asia/Kolkata
# Subscription calendar-day checks (defaults to DEFAULT_TIMEZONE / Asia/Kolkata)
# SUBSCRIPTION_CALENDAR_TZ=Asia/Kolkata

# Rate Limiting (Optional)
# Default: 300 requests per 1 minute
# RATE_LIMIT_MAX_REQUESTS=300
# RATE_LIMIT_WINDOW_MINUTES=1

# Campaign send pacing (WhatsApp Cloud API). Default mode is "auto": reads Meta tier + quality +
# throughput and picks a safe send rate (non-BSP hard caps apply). Use "safe" for slowest, "fast" for
# tier-based speed with safety margins. Overrides below still apply when set.
# CAMPAIGN_PACING_MODE=auto
# CAMPAIGN_PACING_MODE=safe
# CAMPAIGN_PACING_MODE=fast
#
# Optional overrides (normally leave unset so auto pacing applies):
# CAMPAIGN_INTER_MESSAGE_DELAY_MS=2000
# CAMPAIGN_SEND_CONCURRENCY=1
# CAMPAIGN_CHUNK_PAUSE_EVERY=50
# CAMPAIGN_CHUNK_PAUSE_MS=45000
# CAMPAIGN_SEND_MAX_ATTEMPTS=3
#
# After a campaign run finishes with at least one send-failure (no WhatsApp message id), run one automatic
# background retry pass. Delivery failures (Meta rejected after send) are NOT auto-retried.
# CAMPAIGN_AUTO_RETRY_FAILED=false
# CAMPAIGN_AUTO_RETRY_FAILED_COOLDOWN_MS=60000
#
# Optional: limit parallel campaigns in THIS PM2 process (unset = legacy unlimited parallel).
# Use on a busy VPS where each whitelabel has its own PM2 app (same app name, different folders).
# CAMPAIGN_MAX_PARALLEL_EXECUTIONS=1
#
# Optional: scheduler poll interval (ms). Default 30000 (30s).
# CAMPAIGN_SCHEDULER_INTERVAL_MS=60000
#
# Optional: contacts sync interval (ms). Default 300000 (5 min). Disable: DISABLE_CONTACTS_SYNC_SCHEDULER=true
# CONTACTS_SYNC_INTERVAL_MS=900000
#
# Optional: PostgreSQL pool max for self-hosted PG (not Neon). Default 10 if unset.
# PG_POOL_MAX=10
#
# -----------------------------------------------------------------------------
# Media storage — choose ONE setup (same /uploads/... URLs in DB either way)
# -----------------------------------------------------------------------------
#
# OPTION A — Local uploads/ folder (default; Hostinger, local dev, no AWS)
MEDIA_STORAGE=local
#
# OPTION B — Amazon S3 (production EC2; private bucket, app serves /uploads/...)
# MEDIA_STORAGE=s3
# AWS_S3_BUCKET=helicoptic-media-prod
# AWS_REGION=ap-south-1
# AWS_S3_PREFIX=uploads
# EC2: use IAM role (s3:GetObject, PutObject, DeleteObject, ListBucket). No keys needed.
#
# OPTION C — Migration: write both disk + S3, then switch to s3-only
# MEDIA_STORAGE=dual
# AWS_S3_BUCKET=helicoptic-media-prod
# AWS_REGION=ap-south-1
# npx tsx scripts/sync-uploads-to-s3.ts
#
# Accepted values for MEDIA_STORAGE: local | folder | disk | s3 | dual
#
# Database schema sync (after pulling code with new tables/columns):
#   npm run db:sync
# Applies Drizzle schema (shared/schema.ts) + SQL files in migrations/sync-manifest.json
# Safe to re-run — already-applied SQL migrations are tracked and skipped.
#
# Optional: reduce per-recipient campaign console.log noise on a loaded server.
# CAMPAIGN_QUIET_LOGS=true

# Git / Updates (Optional - for Admin > Updates: pull, build, restart from panel)
# Option A: Customer panel API (recommended when using multi-tenant panel)
# The app will call {{CUSTOMER_API_BASE_URL}}/api/customer with header X-Production-Key to get
# github_repo_url, github_token / github_password and use them for git pull.
# CUSTOMER_API_BASE_URL=https://your-panel-domain.com
# PRODUCTION_KEY=WL-xxxxxxxx-MLKG22FD
#
# Branding / public site org (reported to SaaS via GET /api/remote/panel-summary as whitelabel_org_id).
# WHITELABEL_ORG_ID=your-org-uuid
#
# Whitelabel: daily sync of GET {{CUSTOMER_API_BASE_URL}}/api/customer → platform_master_settings (Admin → Platform settings; read-only).
# PLATFORM_MASTER_SYNC_INTERVAL_MS=86400000
# DISABLE_PLATFORM_MASTER_SYNC=true
# Store /api/customer verbatim in DB (secrets included — lock down DB backups). Default: redact secrets before save.
# PLATFORM_MASTER_STORE_UNREDACTED_UPSTREAM=true
# If the portal sometimes omits keys, carry forward previous snapshot values for those keys only (explicit null still wins).
# PLATFORM_MASTER_MERGE_UPSTREAM_ABSENT_KEYS=true
# Option B: Direct GitHub credentials (when not using panel API)
# GITHUB_TOKEN=ghp_your_github_personal_access_token
# GIT_REMOTE_URL=https://username:token_or_password@github.com/owner/repo.git

# Log rotation: truncates logs/*.log when they exceed max size, deletes logs older than retention days
# DISABLE_LOG_ROTATION=true
# LOG_ROTATE_MAX_MB=10
# LOG_ROTATE_INTERVAL_HOURS=6
# LOG_RETENTION_DAYS=1

# Webhook log cleanup: deletes logs/webhook-logs/*.jsonl older than retention days
# DISABLE_WEBHOOK_LOG_CLEANUP=true
# WEBHOOK_LOG_RETENTION_DAYS=1
# WEBHOOK_LOG_CLEANUP_INTERVAL_HOURS=1
