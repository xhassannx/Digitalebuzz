			"item": [
				{
					"name": "Validate Agency (Authenticate)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.TokenId) {",
									"        pm.collectionVariables.set('token', jsonData.TokenId);",
									"    }",
									"    if (jsonData.SessionId) {",
									"        pm.collectionVariables.set('session_id', jsonData.SessionId);",
									"    }",
									"    if (jsonData.TraceId) {",
									"        pm.collectionVariables.set('trace_id', jsonData.TraceId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ClientId\": \"{{username}}\",\n    \"UserName\": \"{{username}}\",\n    \"Password\": \"{{api_password}}\",\n    \"EndUserIp\": \"192.168.1.1\",\n    \"TokenId\": \"\"\n}"
						},
