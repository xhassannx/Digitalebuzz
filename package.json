    "db:migrate-automation-run-logs": "tsx server/scripts/run-automation-run-logs-migration.ts",
    "db:migrate-automation": "tsx server/scripts/run-automation-migrations.ts",
    "db:migrate-drip-campaigns": "tsx server/scripts/run-drip-campaigns-migration.ts",
