  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --banner:js=\"import {setDefaultResultOrder} from 'node:dns';if(typeof setDefaultResultOrder==='function')setDefaultResultOrder('ipv4first');import 'dotenv/config';\"",
    "db:ping": "tsx --env-file=.env scripts/db-ping.ts",
    "db:probe": "tsx --env-file=.env scripts/db-probe.ts",
