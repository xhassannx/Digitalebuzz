    "pm2:restart": "pm2 restart helicoptic-whatsapp",
    "pm2:logs": "pm2 logs helicoptic-whatsapp",
    "pm2:monit": "pm2 monit",
    "pm2:delete": "pm2 delete helicoptic-whatsapp",
    "pm2:save": "pm2 save",
    "deploy": "npm run build && pm2 restart helicoptic-whatsapp",
