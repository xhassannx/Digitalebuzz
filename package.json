    "db:inspect-mongo": "tsx scripts/inspect-mongo.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "npx drizzle-kit push --force && npm run db:migrate-system-free-plan && npm run db:seed-country-dials",
    "db:push:schema-only": "npx drizzle-kit push --force",
    "db:sync": "tsx server/scripts/db-sync.ts",
